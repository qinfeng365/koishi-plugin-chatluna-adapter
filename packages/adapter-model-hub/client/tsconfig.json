{
    "compilerOptions": {
        "rootDir": "../",
        "module": "esnext",
        "moduleResolution": "node",
        "target": "es2022",
        "jsx": "preserve",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "types": ["@koishijs/client/global", "../"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["../src/*"]
        }
    },
    "include": ["."]
}
